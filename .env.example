# HomeFoods backend — template. Copy to .env and fill in; .env is gitignored.

# ---------- Cloudflare ----------
CLOUDFLARE_ACCOUNT_ID=<account-id>
R2_BUCKET_IMAGES=homefoods-images
R2_BUCKET_INVOICES=homefoods-invoices
# S3 API endpoint for presigned URLs (used by the future r2-presign edge function)
R2_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# R2 S3 credentials: create in the dashboard when building the presign edge function:
#   Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Create API token
#   (Object Read & Write, scope it to the two buckets above)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public base URL for serving images: set after the domain is bought and
# connected (R2 custom domain, e.g. https://img.homefoods.in)
R2_PUBLIC_BASE_URL=

# ---------- Supabase (hosted project — fill in after Phase 5 link) ----------
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
